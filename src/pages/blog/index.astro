import PostStream from "../../components/PostStream.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
---

<!doctype html>
<html lang="en">
  <head
    ><BaseHead
      title={"Writing | " + SITE_TITLE}
      description={SITE_DESCRIPTION}
    /></head
  >
  <body>
    <Header />
    <main><h1>Writing</h1><PostStream /></main>
    <Footer />
  </body>
</html>
